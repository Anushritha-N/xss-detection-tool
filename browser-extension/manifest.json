
{
  "manifest_version": 3,
  "name": "XSS Security Inspector",
  "version": "1.0.0",
  "description": "Inspect web pages for form inputs and potential XSS-related security risks.",
  "permissions": ["activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "XSS Security Inspector"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:5000/*", "http://localhost:5000/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
